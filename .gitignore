# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage*
htmlcov/

# Node
node_modules/
frontend/dist/

# Bulk data. Raw FITS caches are re-fetchable from NASA (MAST / s3://stpubdata)
# and stay local-only; everything else under data/ and the promoted model run
# are DVC-tracked — git carries the .dvc pointers (and DVC's per-directory
# .gitignore files), R2 carries the bytes.
data/raw/
data/interim/
models/cv/*
!models/cv/*.dvc
mlruns/
outputs/
multirun/

# DVC internals (pointers *are* committed; cache is not)
.dvc/cache/
.dvc/tmp/

# Environments & editors
.env
.envrc
.DS_Store
.idea/
.vscode/

# MLflow local tracking store
mlflow.db
optuna.db

# Training-run outputs (plots, tier tables) — MLflow/DVC territory
# `results/*` rather than `results/`: git cannot re-include a path whose parent
# directory is itself excluded, and the pointer below has to be re-includable.
results/*
# ...except DVC pointers. The serving API reads candidates_scored.parquet for
# the catalogue's P(planet) column, so that artefact has to reach the container
# the same way the catalogue and the CV runs do: a tiny pointer in git, the
# bytes pulled from R2 at boot.
!results/*.dvc
.claude/

# TRICERATOPS writes <TIC>_TRILEGAL.csv into the cwd (vendor funcs.py:331).
# Per-target star-count queries — regenerable, and one got committed by a
# `git add -A` during a validation run.
*_TRILEGAL.csv

# Stage 8 arm N (synthetic negatives) build products. Re-derivable from
# scripts/build_synthetic_negatives.py; the arm's result is recorded in
# roadmap 3.9b. Neither DVC-tracked nor ignored until now, so they showed up
# as untracked bulk on every status.
data/processed/synthetic_negatives/
data/processed/viewset_tfrecords_synneg/

# Stage 9 arm build products: the view set with the difference-image views, and
# its shards. Re-derivable in under a minute from
# `build_viewset.py --views-from`, and 296 MB + shards of bulk otherwise. Same
# treatment as the arm-N products above; the production set stays DVC-tracked.
data/processed/viewset_stage9/
data/processed/viewset_tfrecords_stage9/

# Stage 9 CV arms. Deliberately outside models/cv/: the weekly gate selects its
# candidate as the newest models/cv/*/cv_summary.json that is not the control
# lane, so an experimental arm left there is one skipped train step away from
# being gated as a promotion candidate. Results are recorded in roadmap 4.2.
models/stage9/

# TypeScript incremental build cache — regenerated by every `npm run build`,
# so tracking it dirties the tree on each verification.
frontend/tsconfig.tsbuildinfo

# ai-slop-detector local state. The analysis cache is keyed without the Python
# environment, so it is a local artefact, never shared. .slopconfig.yaml IS
# tracked — CI and local runs must score the same code the same way.
.slop-detector/
