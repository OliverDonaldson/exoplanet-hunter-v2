# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage*
htmlcov/

# Node
node_modules/
frontend/dist/

# Bulk data. Raw FITS caches are re-fetchable from NASA (MAST / s3://stpubdata)
# and stay local-only; everything else under data/ and the promoted model run
# are DVC-tracked — git carries the .dvc pointers (and DVC's per-directory
# .gitignore files), R2 carries the bytes.
data/raw/
data/interim/
models/cv/*
!models/cv/*.dvc
mlruns/
outputs/
multirun/

# DVC internals (pointers *are* committed; cache is not)
.dvc/cache/
.dvc/tmp/

# Environments & editors
.env
.envrc
.DS_Store
.idea/
.vscode/

# MLflow local tracking store
mlflow.db
optuna.db

# Training-run outputs (plots, tier tables) — MLflow/DVC territory
results/
.claude/

# TRICERATOPS writes <TIC>_TRILEGAL.csv into the cwd (vendor funcs.py:331).
# Per-target star-count queries — regenerable, and one got committed by a
# `git add -A` during a validation run.
*_TRILEGAL.csv

# Stage 8 arm N (synthetic negatives) build products. Re-derivable from
# scripts/build_synthetic_negatives.py; the arm's result is recorded in
# roadmap 3.9b. Neither DVC-tracked nor ignored until now, so they showed up
# as untracked bulk on every status.
data/processed/synthetic_negatives/
data/processed/viewset_tfrecords_synneg/

# TypeScript incremental build cache — regenerated by every `npm run build`,
# so tracking it dirties the tree on each verification.
frontend/tsconfig.tsbuildinfo
